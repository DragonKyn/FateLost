{
  "name": "fate-lost-multiplayer",
  "version": "1.0.0",
  "private": true,
  "description": "Cloudflare Worker and Durable Objects behind Fate Lost's cooperative multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --env test --port 8799",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "test": "npm run typecheck && npm run test:unit && node scripts/with-dev-server.mjs npm run test:integration",
    "test:staging": "cross-env FATE_BASE_URL=https://fate-lost-multiplayer-staging.wickedstudiosca.workers.dev vitest run test/integration",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "cross-env": "^7.0.3",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0",
    "ws": "^8.18.0"
  }
}
